{
  "name": "datasource-databend",
  "version": "1.1.3",
  "description": "Grafana datasource plugin for Databend",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "pnpm exec grafana-e2e run",
    "e2e:update": "pnpm exec grafana-e2e run --update-screenshots",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "pnpm run lint -- --fix",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "author": "Databend Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^8.2.0",
    "@grafana/experimental": "^2.1.6",
    "@grafana/plugin-e2e": "^3.6.0",
    "@grafana/tsconfig": "^2.0.0",
    "@swc/core": "^1.13.5",
    "@swc/helpers": "^0.5.17",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.8.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.3",
    "eslint-webpack-plugin": "^6.0.0",
    "glob": "^13.0.3",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.8.1",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.99.0",
    "sass-loader": "16.0.7",
    "style-loader": "4.0.0",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "webpack": "^5.105.0",
    "webpack-cli": "^7.0.1",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.4.2",
    "@grafana/runtime": "12.4.2",
    "@grafana/schema": "12.4.2",
    "@grafana/ui": "12.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "^7.8.2",
    "tslib": "2.8.1"
  },
  "packageManager": "pnpm@10.11.0"
}
